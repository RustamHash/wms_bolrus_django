{% load wms %}
<div class="card grid" style="margin-bottom: 1rem;">
  <label>Строка задания
    <select name="task_line_id" required>
      <option value=""></option>
      {% for line in loose_lines %}
      <option value="{{ line.line.id }}">{{ line.line.product.name }} · {{ line.line.caliber.name|default:"без калибра" }} · {{ line.line.grade.name|default:"без сорта" }} (ост. {{ line.left|kg }} кг)</option>
      {% endfor %}
    </select>
  </label>

  <label>ид паллета
    <select name="pallet_type" required>
      <option value="EUR" {% if last_pallet.pallet_type == 'EUR' %}selected{% endif %}>вро</option>
      <option value="USA" {% if last_pallet.pallet_type == 'USA' %}selected{% endif %}>мериканец</option>
    </select>
  </label>

  <label>паковка
    <select name="packaging_id" required>
      <option value=""></option>
      {% for pk in packagings %}
      <option value="{{ pk.id }}" {% if last_pallet.packaging_id == pk.id %}selected{% endif %}>{{ pk.name }}</option>
      {% endfor %}
    </select>
  </label>

  <label>алибр
    <select name="caliber_id" required>
      <option value=""></option>
      {% for c in calibers %}
      <option value="{{ c.id }}" {% if last_pallet.caliber_id == c.id %}selected{% endif %}>{{ c.name }}</option>
      {% endfor %}
    </select>
  </label>

  <label>Сортность
    <select name="grade_id" required>
      <option value=""></option>
      {% for g in grades %}
      <option value="{{ g.id }}" {% if last_pallet.grade_id == g.id %}selected{% endif %}>{{ g.name }}</option>
      {% endfor %}
    </select>
  </label>

  <label>ол-во упаковок <input name="places" inputmode="numeric" required></label>
  
  <label>рязный вес, кг <input name="gross" inputmode="decimal" required></label>
  
  <label class="check"><input type="checkbox" name="net_manual" value="1" onclick="document.getElementById('net-input').style.display = this.checked ? 'block' : 'none'"> вести чистый вес вручную</label>
  <label id="net-input" style="display:none">истый вес, кг <input name="net" inputmode="decimal"></label>

  {% if consignee_categories %}
  <fieldset>
    <legend>атегории отгрузки (на выход)</legend>
    {% for cat in consignee_categories %}
    <label class="check">
      <input type="checkbox" name="category_id" value="{{ cat.id }}" 
             {% if last_pallet and cat.id in last_pallet.category_ids %}checked{% endif %}>
      {{ cat.name }}
    </label>
    {% endfor %}
  </fieldset>
  {% endif %}

  {% include "partials/cell_pick.html" %}

  <div class="actions"><button type="submit">ринять паллету</button></div>
</div>
